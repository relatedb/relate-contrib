{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph descriptor, version 1",
  "description": "Describes a graph beside its data (ADR-003). `shape` and `embeddings` are reserved for a later decision and rejected in version 1.",
  "type": "object",
  "required": [
    "version",
    "id",
    "revision",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,48}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "required": [
        "url",
        "nodes",
        "links"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "property"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
