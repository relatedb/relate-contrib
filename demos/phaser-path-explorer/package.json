{
  "name": "phaser-path-explorer",
  "version": "0.0.0",
  "description": "A Phaser demo where exploring is querying: a thread extended across a hidden hex map, backed by an embedded Relate graph (ADR-011).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "extract-assets": "node scripts/extract-assets.mjs",
    "test:phaser-browsers": "playwright test"
  },
  "dependencies": {
    "@fontsource/share-tech-mono": "^5.3.0",
    "@relate/relate-phaser": "workspace:*",
    "@relate/relate-wasm": "*",
    "@relate/web": "workspace:*",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
