{
  "name": "react-admin-demo",
  "version": "0.0.0",
  "description": "A local-first administrative application over the embedded graph: react-admin, the @relate/react-admin data provider and an application graph that keeps what the visitor writes.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5190 --strictPort",
    "seed": "tsx scripts/make-seed.ts",
    "test:react-admin-browsers": "playwright test",
    "test:react-admin-demo": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json"
  },
  "dependencies": {
    "@relate/react-admin": "workspace:*",
    "@relate/web": "workspace:*",
    "@tanstack/react-query": "^5.83.0",
    "react": "^19.3.1",
    "react-admin": "5.15.6",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.72.0",
    "react-router": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@relate/relate-wasm": "*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  }
}
