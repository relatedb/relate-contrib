{
  "name": "@relate/contrib-observable",
  "version": "0.1.3",
  "description": "Observable Framework helpers for @relate/contrib-web: loaders that place the engine and the worker and publish graph data, a call that ties a graph client to a cell, and result shaping for Framework's components.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relatedb/relate-contrib.git",
    "directory": "packages/observable"
  },
  "homepage": "https://github.com/relatedb/relate-contrib/tree/main/packages/observable#readme",
  "bugs": {
    "url": "https://github.com/relatedb/relate-contrib/issues"
  },
  "keywords": [
    "relate",
    "relatedb",
    "observable",
    "observable-framework",
    "graph",
    "wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "default": "./dist/loader/index.js"
    },
    "./results": {
      "types": "./dist/results/index.d.ts",
      "default": "./dist/results/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:observable": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "test:observable-browsers": "playwright test --grep-invert \"@conformance|@figures\"",
    "test:observable-conformance": "REL_REPORT=reports/conformance.json playwright test --grep @conformance",
    "test:observable-package": "vitest run --config vitest.package.config.ts --reporter=default --reporter=json --outputFile.json=reports/package.json",
    "test:observable-trace": "tsx tests/trace/check-trace.ts"
  },
  "peerDependencies": {
    "@observablehq/framework": "^1.13.0",
    "@relate/contrib-web": ">=0.0.0 <1.0.0",
    "@relate/relate-wasm": ">=1.3.0 <1.5.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@observablehq/framework": "^1.13.4",
    "@playwright/test": "^1.64.1",
    "@relate/contrib-web": "workspace:*",
    "@relate/relate-wasm": "catalog:",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
