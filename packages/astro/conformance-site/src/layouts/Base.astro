---
// The markup the core's conformance scenarios drive (see packages/core/conformance/example-site/rel-page.ts):
// every observable thing is a `data-rel-*` element. The router is present only when this build is for client-routing.
import { ClientRouter } from "astro:transitions";
interface Props {
  title: string;
  notesPage?: boolean;
  bare?: boolean;
  /** The graph the page's script queries, and the label it counts. */
  graph?: string;
  label?: string;
  variant?: string;
}
const { title, notesPage = false, bare = false, graph = "example", label = "Page", variant } = Astro.props;
// ROUTER=on|off forces the router in or out, to make a build whose setting disagrees with it (the development warning).
const routed = process.env.ROUTER ? process.env.ROUTER === "on" : process.env.NAVIGATION === "client-routing";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {routed && <ClientRouter fallback="swap" />}
  </head>
  <body data-rel-graph={graph} data-rel-label={label} data-rel-variant={variant} {...(notesPage ? { "data-rel-notes-page": "" } : {})}>
    <main>
      <h1 data-rel-title>{title}</h1>
      <nav>
        <a data-rel-link href="/index.html">Home</a>
        <a data-rel-link href="/page-1.html">Page 1</a>
        <a data-rel-link href="/page-2.html">Page 2</a>
        <a data-rel-link href="/notes.html">Notes</a>
        <a data-rel-link href="/broken.html">Broken</a>
        <a data-rel-link href="/lifetime-a.html">Lifetime A</a>
        <a data-rel-link href="/lifetime-b.html">Lifetime B</a>
        <a data-rel-link href="/inline.html">Inline</a>
      </nav>
      <slot />
      {!bare && (
        <section>
          <p>Status: <span data-rel-status>loading</span> · generation <span data-rel-generation>0</span> ·
            profile <span data-rel-profile></span> · instance <span data-rel-instance></span> ·
            restored <span data-rel-restored>unknown</span></p>
          <p>Pages in the graph: <span data-rel-count>…</span> · updates <span data-rel-updates>0</span> ·
            last error <span data-rel-last-error></span></p>
          <p data-rel-failure></p>
          <p data-rel-notes-row hidden>Notes: <span data-rel-notes>…</span></p>
          <p>
            <button type="button" data-rel-action="trap">Run a statement that crashes the engine</button>
            <button type="button" data-rel-action="timeout">Run a statement that never ends (0.4 s timeout)</button>
          </p>
        </section>
      )}
    </main>
    <script>import "../scripts/rel-page";</script>
  </body>
</html>
