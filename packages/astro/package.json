{
  "name": "@relate/web-astro",
  "version": "0.0.0",
  "description": "Astro integration for @relate/web-core: serves graphs built from a site's content, carries small graphs in pages, and ties a page's graph clients to the router.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/GraphData.astro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph-data": "./src/GraphData.astro",
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/types.d.ts dist/types.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:astro": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "test:astro-browsers": "playwright test --grep-invert \"@conformance|@figures\"",
    "test:astro-conformance": "GW_REPORT=reports/conformance.json playwright test --grep @conformance",
    "test:astro-package": "vitest run --config vitest.package.config.ts --reporter=default --reporter=json --outputFile.json=reports/package.json",
    "test:astro-trace": "tsx tests/trace/check-trace.ts"
  },
  "peerDependencies": {
    "@neo4j-labs/cypherlite-wasm": "*",
    "astro": "^7.4.0",
    "@relate/web-core": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "astro": "^7.4.5",
    "@relate/web-core": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
