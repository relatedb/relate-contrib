{
  "name": "@relate/contrib-astro",
  "version": "0.0.0",
  "description": "Astro integration for @relate/contrib-web: serves graphs built from a site's content, carries small graphs in pages, and ties a page's graph clients to the router.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relatedb/relate-contrib.git",
    "directory": "packages/astro"
  },
  "homepage": "https://github.com/relatedb/relate-contrib/tree/main/packages/astro#readme",
  "bugs": {
    "url": "https://github.com/relatedb/relate-contrib/issues"
  },
  "keywords": [
    "relate",
    "relatedb",
    "astro",
    "astro-integration",
    "graph",
    "wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/GraphData.astro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph-data": "./src/GraphData.astro",
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/types.d.ts dist/types.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:astro": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "test:astro-browsers": "playwright test --grep-invert \"@conformance|@figures\"",
    "test:astro-conformance": "REL_REPORT=reports/conformance.json playwright test --grep @conformance",
    "test:astro-package": "vitest run --config vitest.package.config.ts --reporter=default --reporter=json --outputFile.json=reports/package.json",
    "test:astro-trace": "tsx tests/trace/check-trace.ts"
  },
  "peerDependencies": {
    "@relate/contrib-web": ">=0.0.0 <1.0.0",
    "@relate/relate-wasm": ">=0.16.1 <=0.16.1",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@relate/contrib-web": "workspace:*",
    "@types/node": "^26.6.6",
    "astro": "^7.4.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
