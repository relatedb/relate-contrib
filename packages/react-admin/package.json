{
  "name": "@relate/contrib-react-admin",
  "version": "0.0.0",
  "description": "A react-admin data provider over a @relate/contrib-web client: lists, filters, sorting, paging, references and writes, translated into parameterised statements from a declared schema.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:react-admin": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "test:react-admin-package": "vitest run --config vitest.package.config.ts --reporter=default --reporter=json --outputFile.json=reports/package.json",
    "test:react-admin-trace": "tsx tests/trace/check-trace.ts",
    "measure": "tsx scripts/measure.ts"
  },
  "peerDependencies": {
    "@relate/contrib-web": "*",
    "react-admin": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@relate/relate-wasm": "*",
    "@relate/contrib-web": "workspace:*",
    "@tanstack/react-query": "^5.83.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.3.1",
    "react-admin": "5.15.6",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.72.0",
    "react-router": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
