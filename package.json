{
  "name": "relate-contrib",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm run test:unit && pnpm run test:browsers",
    "test:unit": "pnpm --filter @relate/contrib-web test:unit",
    "test:browsers": "pnpm --filter @relate/contrib-web test:browsers",
    "test:perf": "pnpm --filter @relate/contrib-web test:perf",
    "test:conformance": "pnpm --filter @relate/contrib-web test:conformance",
    "test:package": "pnpm --filter @relate/contrib-web test:package",
    "test:trace": "pnpm --filter @relate/contrib-web test:trace",
    "test:astro": "pnpm --filter @relate/contrib-astro test:astro",
    "test:astro-browsers": "pnpm --filter @relate/contrib-astro test:astro-browsers",
    "test:astro-conformance": "pnpm --filter @relate/contrib-astro test:astro-conformance",
    "test:astro-package": "pnpm --filter @relate/contrib-astro test:astro-package",
    "test:astro-trace": "pnpm --filter @relate/contrib-astro test:astro-trace",
    "test:next": "pnpm --filter @relate/contrib-nextjs test:next",
    "test:next-browsers": "pnpm --filter @relate/contrib-nextjs test:next-browsers",
    "test:next-conformance": "pnpm --filter @relate/contrib-nextjs test:next-conformance",
    "test:next-package": "pnpm --filter @relate/contrib-nextjs test:next-package",
    "test:next-trace": "pnpm --filter @relate/contrib-nextjs test:next-trace",
    "test:observable": "pnpm --filter @relate/contrib-observable test:observable",
    "test:observable-browsers": "pnpm --filter @relate/contrib-observable test:observable-browsers",
    "test:observable-conformance": "pnpm --filter @relate/contrib-observable test:observable-conformance",
    "test:observable-package": "pnpm --filter @relate/contrib-observable test:observable-package",
    "test:observable-trace": "pnpm --filter @relate/contrib-observable test:observable-trace",
    "test:sveltekit": "pnpm --filter @relate/contrib-sveltekit test:sveltekit",
    "test:sveltekit-browsers": "pnpm --filter @relate/contrib-sveltekit test:sveltekit-browsers",
    "test:sveltekit-conformance": "pnpm --filter @relate/contrib-sveltekit test:sveltekit-conformance",
    "test:sveltekit-package": "pnpm --filter @relate/contrib-sveltekit test:sveltekit-package",
    "test:sveltekit-trace": "pnpm --filter @relate/contrib-sveltekit test:sveltekit-trace",
    "test:react-admin": "pnpm --filter @relate/contrib-react-admin test:react-admin && pnpm --filter react-admin-demo test:react-admin-demo",
    "test:react-admin-browsers": "pnpm --filter react-admin-demo test:react-admin-browsers",
    "test:react-admin-package": "pnpm --filter @relate/contrib-react-admin test:react-admin-package",
    "test:react-admin-trace": "pnpm --filter @relate/contrib-react-admin test:react-admin-trace",
    "test:phaser": "pnpm --filter @relate/contrib-phaser test:phaser && pnpm --filter phaser-path-explorer test",
    "test:phaser-browsers": "pnpm --filter phaser-path-explorer test:phaser-browsers",
    "test:phaser-package": "pnpm --filter @relate/contrib-phaser test:phaser-package",
    "test:phaser-trace": "pnpm --filter @relate/contrib-phaser test:phaser-trace",
    "test:application": "pnpm --filter @relate/contrib-web test:application",
    "test:application-browsers": "pnpm --filter @relate/contrib-web test:application-browsers",
    "test:application-trace": "pnpm --filter @relate/contrib-web test:application-trace",
    "test:catalog": "pnpm --filter @relate/contrib-web test:catalog",
    "test:catalog-browsers": "pnpm --filter @relate/contrib-web test:catalog-browsers",
    "test:catalog-trace": "pnpm --filter @relate/contrib-web test:catalog-trace",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/release/tsconfig.json",
    "test:units": "pnpm run test:unit && pnpm run test:application && pnpm run test:catalog && pnpm run test:astro && pnpm run test:next && pnpm run test:observable && pnpm run test:sveltekit && pnpm run test:react-admin && pnpm run test:phaser && pnpm run test:release",
    "test:conformance-all": "pnpm run test:conformance && pnpm run test:astro-conformance && pnpm run test:next-conformance && pnpm run test:observable-conformance && pnpm run test:sveltekit-conformance",
    "test:drift": "pnpm run build && pnpm run typecheck && pnpm run test:units && pnpm run test:conformance-all",
    "test:browsers-all": "pnpm run test:browsers && pnpm run test:application-browsers && pnpm run test:catalog-browsers && pnpm run test:astro-browsers && pnpm run test:next-browsers && pnpm run test:observable-browsers && pnpm run test:sveltekit-browsers && pnpm run test:react-admin-browsers && pnpm run test:phaser-browsers",
    "test:packages-all": "pnpm run test:package && pnpm run test:astro-package && pnpm run test:next-package && pnpm run test:observable-package && pnpm run test:sveltekit-package && pnpm run test:react-admin-package && pnpm run test:phaser-package",
    "test:traces-all": "pnpm run test:trace && pnpm run test:application-trace && pnpm run test:catalog-trace && pnpm run test:astro-trace && pnpm run test:next-trace && pnpm run test:observable-trace && pnpm run test:sveltekit-trace && pnpm run test:react-admin-trace && pnpm run test:phaser-trace && pnpm run test:release-trace",
    "test:all": "pnpm run test:drift && pnpm run test:browsers-all && pnpm run test:packages-all && pnpm run test:traces-all",
    "release:check-publishable": "tsx scripts/release/check-publishable.ts",
    "release:check-engine-range": "tsx scripts/release/check-engine-range.ts",
    "release:check-changes": "tsx scripts/release/check-changes.ts",
    "release:gate": "tsx scripts/release/release-gate.ts",
    "release:plan": "tsx scripts/release/plan-release.ts",
    "test:release": "vitest run --root scripts/release --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "test:release-trace": "tsx scripts/release/trace/check-trace.ts",
    "test:engine-assumptions": "pnpm --filter @relate/contrib-web --filter @relate/contrib-phaser --filter @relate/contrib-react-admin --filter @relate/contrib-astro --filter @relate/contrib-nextjs --filter @relate/contrib-observable --filter @relate/contrib-sveltekit exec vitest run tests/unit/engine-assumptions.test.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "pnpm release:check-publishable && pnpm release:check-engine-range && pnpm release:check-changes"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "semver": "^7.8.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
