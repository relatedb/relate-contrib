{
  "name": "related-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "pnpm -r build",
    "test": "pnpm run test:unit && pnpm run test:browsers",
    "test:unit": "pnpm --filter related-web-core test:unit",
    "test:browsers": "pnpm --filter related-web-core test:browsers",
    "test:conformance": "pnpm --filter related-web-core test:conformance",
    "test:package": "pnpm --filter related-web-core test:package",
    "test:trace": "pnpm --filter related-web-core test:trace",
    "test:astro": "pnpm --filter related-web-astro test:astro",
    "test:astro-browsers": "pnpm --filter related-web-astro test:astro-browsers",
    "test:astro-conformance": "pnpm --filter related-web-astro test:astro-conformance",
    "test:astro-package": "pnpm --filter related-web-astro test:astro-package",
    "test:astro-trace": "pnpm --filter related-web-astro test:astro-trace",
    "test:next": "pnpm --filter @relate/web-next test:next",
    "test:next-browsers": "pnpm --filter @relate/web-next test:next-browsers",
    "test:next-conformance": "pnpm --filter @relate/web-next test:next-conformance",
    "test:next-package": "pnpm --filter @relate/web-next test:next-package",
    "test:next-trace": "pnpm --filter @relate/web-next test:next-trace"
  }
}
