node_modules/
dist/
vendor/relate-wasm/
vendor/.build/
test-results/
playwright-report/
reports/
*.log
.env*
.DS_Store

# Compiled output belongs in dist/ only; never beside the sources
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/tests/**/*.js
packages/*/tests/**/*.d.ts
packages/*/tests/**/*.js.map
packages/*/conformance/*.js
packages/*/conformance/*.d.ts
packages/*/conformance/*.js.map

# These two declare the adapter's virtual modules and are source, not build output
!packages/astro/src/types.d.ts
!packages/astro/src/env.d.ts

# Scratch projects made by the Observable adapter's build tests, its reports and build output
packages/observable/.tmp/
packages/observable/conformance-site/dist/
packages/observable/conformance-site/docs/.observablehq/
