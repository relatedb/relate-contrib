---
// SPIKE-004 steps 2 and 5: main thread against dedicated worker.
// /bench/?host=main|worker&graph=/synthetic/graph-1000.json[&store=name][&runs=30]
// Results land in window.__bench and in the <pre>.
---

<html lang="en">
  <head><meta charset="utf-8" /><title>Bench</title></head>
  <body>
    <div id="box" style="width:40px;height:40px;background:#07c;position:relative"></div>
    <pre id="out">running…</pre>
    <script>
      import {openGraph} from "../lib/graphClient.js";
      import {WorkerDb} from "../lib/worker/workerDb.js";

      const params = new URLSearchParams(location.search);
      const host = params.get("host") ?? "main";
      const graph = params.get("graph") ?? "/synthetic/graph-1000.json";
      const store = params.get("store");
      const runs = Number(params.get("runs") ?? 30);
      const round = (v) => Math.round(v * 10) / 10;
      const median = (xs) => [...xs].sort((a, b) => a - b)[Math.floor(xs.length / 2)];
      const mean = (xs) => xs.reduce((a, b) => a + b, 0) / xs.length;

      // Gaps in a timer heartbeat while loading. A page that is not being
      // rendered gets no animation frames, so a 4 ms timer stands in for the
      // animation: a gap far above 4 ms means the main thread was blocked.
      const frames: number[] = [];
      let last = performance.now();
      let animating = true;
      const box = document.getElementById("box")!;
      const tick = () => {
        const now = performance.now();
        frames.push(now - last);
        last = now;
        box.style.left = `${(now / 4) % 300}px`;
        if (animating) setTimeout(tick, 4);
      };
      setTimeout(tick, 4);
      const longtasks: number[] = [];
      try {
        new PerformanceObserver((l) => l.getEntries().forEach((e) => longtasks.push(e.duration))).observe({type: "longtask", buffered: true});
      } catch {}

      const SMALL = "MATCH (p:Page {id: 1}) RETURN p.slug AS s";
      const LARGE = "MATCH (p:Page)-[:LINKS_TO]->(q:Page) RETURN p.id AS a, q.id AS b LIMIT 5000";
      const result: any = {host, graph, store, runs};
      const t0 = performance.now();
      let query: (cypher: string, raw?: boolean) => Promise<any>;
      if (host === "main") {
        const {db, timings} = await openGraph({graphUrl: graph});
        result.timings = timings;
        query = async (cypher) => JSON.parse(db.execute(cypher, null));
      } else {
        const wdb = new WorkerDb({graph, store});
        await wdb.ready;
        result.timings = wdb.timings;
        query = async (cypher, raw) => {
          const {result: r} = await wdb.query(cypher, null, {raw});
          return raw ? JSON.parse(r) : r;
        };
      }
      result.readyMs = round(performance.now() - t0);
      await new Promise((r) => setTimeout(r, 300));
      animating = false;
      const during = frames.slice(0, -1);
      result.frames = {count: during.length, maxGapMs: round(Math.max(...during)), over50: during.filter((g) => g > 50).length, over100: during.filter((g) => g > 100).length};
      result.longtasks = {count: longtasks.length, totalMs: round(longtasks.reduce((a, b) => a + b, 0)), maxMs: round(Math.max(0, ...longtasks))};

      const timed = async (cypher: string, raw = false) => {
        const times: number[] = [];
        let rows = 0;
        for (let i = 0; i < runs; i++) {
          const s = performance.now();
          const r = await query(cypher, raw);
          times.push(performance.now() - s);
          rows = r.rows.length;
        }
        return {rows, meanMs: round(mean(times)), medianMs: round(median(times))};
      };
      result.firstQueryMs = await (async () => { const s = performance.now(); await query(SMALL); return round(performance.now() - s); })();
      result.counts = {pages: (await query("MATCH (p:Page) RETURN count(p) AS c")).rows[0].c, links: (await query("MATCH ()-[r:LINKS_TO]->() RETURN count(r) AS c")).rows[0].c};
      result.small = await timed(SMALL);
      result.large = await timed(LARGE);
      if (host === "worker") result.largeRaw = await timed(LARGE, true);
      (window as any).__bench = result;
      document.getElementById("out")!.textContent = JSON.stringify(result, null, 1);
    </script>
  </body>
</html>
